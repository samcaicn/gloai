# =============================================================================
# Project pnpm configuration
# =============================================================================
# Goals:
#   1. Pin the global store location (C:\pnpm-store) so the root Tauri
#      workspace and the web-ui workspace share the same content-
#      addressable store instead of duplicating packages.
#   2. Speed up installs: isolated node-linker + auto-install-peers avoids
#      the deep hoisting graph that breaks Vite's resolver on Windows.
#   3. Quieter logs in CI: progress=false removes the spinner that eats
#      a line per package on every shell redraw.
# =============================================================================

# Shared content-addressable store. Already the global default on this
# machine (C:\pnpm-store\v3), but pinned here so the project is hermetic.
store-dir=C:\pnpm-store

# `isolated` is the pnpm default since v7; explicitly pinned because
# `hoisted` would silently re-introduce phantom-dependency bugs.
node-linker=isolated

# Auto-install missing peer deps so a fresh `pnpm install` "just works".
auto-install-peers=true

# Don't hard-fail on peer-version mismatches.
strict-peer-dependencies=false

# Hide the progress bar — useful for CI logs and Trae's terminal capture.
progress=false

# Speed up resolution by skipping the optional darwin/linux packages
# on Windows.
os-filter=true

# Allow `pnpm install` at the workspace root without `-w` flag.
ignore-workspace-root-check=true
