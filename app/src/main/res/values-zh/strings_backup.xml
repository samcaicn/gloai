<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="backup_title">备份与数据</string>
    <string name="backup_sub">把全部数据导出成一个 ZIP 文件，或从 ZIP 恢复</string>
    <string name="backup_warning_title">此备份未加密</string>
    <string name="backup_warning_body">ZIP 文件里包含你的所有机密：API 密钥、OAuth 令牌和服务凭据。请妥善保管、不要分享，导入后即删除。</string>
    <string name="backup_included_label">包含哪些内容</string>
    <string name="backup_included_body">服务商与密钥、聊天、人格、技能、记忆、工作流、任务运行记录和设置。</string>
    <string name="backup_excluded_body">不包含：无线调试配对（导入后需重新配对）、无障碍服务开关（需在 Android 设置里重新打开）、沙箱工作区和文件库附件。</string>
    <string name="backup_export">导出备份</string>
    <string name="backup_export_sub">把全部数据保存为一个 ZIP 文件</string>
    <string name="backup_import">导入备份</string>
    <string name="backup_import_sub">从一个备份 ZIP 文件恢复所有内容</string>
    <string name="backup_exported">备份已保存：%1$d 个文件。</string>
    <string name="backup_exported_skipped">备份已保存：%1$d 个文件。有 %2$d 个密钥无法解密，已略过。</string>
    <string name="backup_export_failed">无法保存备份。</string>
    <string name="backup_import_failed">无法导入这份备份。</string>
    <string name="backup_import_confirm_title">替换当前数据？</string>
    <string name="backup_import_confirm_body">这台手机已有聊天和服务商。导入后会替换掉它们。</string>
    <string name="backup_replace">全部替换</string>
    <string name="backup_imported_title">备份已恢复</string>
    <string name="backup_imported_body">已恢复 %1$d 个文件。</string>
    <string name="backup_after_import_body">关闭 Mika 再重新打开，以使用恢复的数据。然后重新配对无线调试、在 Android 设置里重新打开无障碍服务，并删除备份 ZIP 文件。</string>
    <string name="backup_close_app">关闭 Mika</string>
    <string name="backup_restart_note">卸载任何东西之前请先导出：只有当前这份安装才能解密你的数据。</string>
</resources>
