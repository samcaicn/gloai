<?xml version="1.0" encoding="utf-8"?>
<!--
  android.service.notification.notification_listener_filter metadata.
  NOTE: the attributes below are read at runtime by NotificationListenerFilter
  via getAttributeValue(null, ...) — i.e. they are NO-NAMESPACE attributes.
  Do NOT prefix them with android: or AAPT will fail with
  "attribute android:defaultFilterType not found".
-->
<notification-listener defaultFilterType="disallowed">
    <!-- Only listen to WeChat; nothing else needs to reach the capture service. -->
    <package-filter packageName="com.tencent.mm" />
</notification-listener>
