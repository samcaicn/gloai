<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 热更新：下载安装包后拉起系统安装器需要「安装未知应用」授权 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.JevProbe">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".KnowledgeActivity"
            android:exported="false" />

        <!-- 热更新：把下载好的安装包暴露给系统安装器（仅缓存目录、仅读） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="com.google.android.accessibility.selecttospeak.SelectToSpeakService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/config_disguised" />
        </service>

        <service
            android:name=".capture.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep the accessibility reader alive on aggressive OEM power management" />
        </service>

        <!-- 开机后若用户曾开启助手，发恢复通知（无障碍无法被代码启动，只引导回设置页）。 -->
        <receiver
            android:name=".capture.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 保活通知上的「暂停/开启自动收发」动作：不依赖 App 进程与 UI，锁屏也能收权。 -->
        <receiver
            android:name=".capture.ControlReceiver"
            android:exported="false" />

        <!-- 本地免费计数重置（adb 调试/CI 验收通道，设置页亦有同效按钮）：
             只清本地当日 count，云端 KV 仍是 30 条/天/设备硬墙。 -->
        <receiver
            android:name=".core.license.QuotaResetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jev.probe.action.RESET_QUOTA" />
            </intent-filter>
        </receiver>

        <!-- 主动发送入口（方案 A/B）：用户在设置页/adb 显式给旧会话发内容。
             export + 令牌校验（Prefs.proactiveToken），校验失败静默丢弃，防冒发。 -->
        <receiver
            android:name=".capture.ProactiveSendReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jev.probe.action.SEND_TO_CHAT" />
            </intent-filter>
        </receiver>

        <!-- WeChat notification listener: the RECEIVE side of unattended mode. -->
        <service
            android:name=".capture.WxNotificationListener"
            android:exported="false"
            android:label="AI聊天助手 · 微信通知"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.notification_listener_filter"
                android:resource="@xml/wx_notification_listener" />
        </service>

        <!-- Probe input method: the ONLY channel that can actually write text into
             WeChat's input bar (8.0.78 strips the a11y tree to ~4 nodes). Users
             enable it once in system settings; fillInput writes via commitText. -->
        <service
            android:name=".input.ProbeInputMethod"
            android:exported="true"
            android:label="AI聊天助手 · 写入"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>

</manifest>
