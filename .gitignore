# ---- Python ----
__pycache__/
*.py[cod]
*$py.class

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/

# ---- Logs ----
wechatauto_logs/
*.log

# ---- Runtime state / user data (do not commit) ----
config.json
config_backups/
Memory_Temp/
CoreMemory/
chat_contexts.json

# ---- Legacy offline wheel bundle (cp39 wheels, unused; project requires Python 3.12+) ----
libs/

# ---- Editor / OS ----
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ---- Local UI preview / dev scaffolding (never shipped) ----
_preview.py
_preview/
_cleanup_junk.py

# ---- Project-local venv (NOT covered by generic venv/ or .venv/ patterns) ----
.venv_bot/

# ---- Local runtime state / secrets (never commit) ----
.restart_stamp
.secret_key
weauto_chat.db
weauto_chat.db-shm
weauto_chat.db-wal
user_timers.json
style_settings.json
style_profile.json
.weauto_license.json

# ---- Runtime download copy of config.py (may contain live API key) ----
_downloads/

# ---- Local debug / CI helper scripts (not shipped) ----
_debug_exe.py
_mock_worker.py
_ci_wait_dl.py
_smoke_guard.py

# ---- 发行版标记（CI 生成，不提交；存在即门禁强制开启）----
weauto_license/_release.py

# ---- 本地 CF 部署工具链（含 node_modules，不提交）----
_cfdeploy/

# ---- wrangler 本地状态（非仓库内容）----
.wrangler/
