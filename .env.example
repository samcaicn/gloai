# CEOadmin Hub 环境变量示例
# 复制为 .env 后填写（docker compose 会自动读取同目录下的 .env）
#
# 通用（可选，均有默认值）
# PASSWORD=ceoadmin
# HUB_PORT=9800
# RP_ORIGIN=http://localhost:9800
# RP_ID=localhost

# 对象存储（S3 兼容，可选）
# 走的是 S3 协议，因此 MinIO / 腾讯云 COS / AWS S3 等只是 endpoint 不同，代码无差别：
#   MinIO（docker compose 自带）  STORAGE_ENDPOINT=minio:9000            STORAGE_SSL 留空
#   腾讯云 COS                    STORAGE_ENDPOINT=cos.<region>.myqcloud.com   STORAGE_SSL=true
#   AWS S3                        STORAGE_ENDPOINT=s3.<region>.amazonaws.com   STORAGE_SSL=true
# 不配置则整个冷层休眠（媒体文件回退到 CDN 代理），Hub 照常运行。
# STORAGE_ENDPOINT=minio:9000
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=ceoadmin
# STORAGE_SSL=true
# 或改用本地目录（未配置 S3 endpoint 时生效）
# STORAGE_PATH=/var/lib/CEOadmin/objects

# 冷热分层：热层 = live SQLite，冷层 = 对象存储上的分区数据集
# 冷层布局：<PREFIX>/conv=<会话>/dt=<日期>/part-<起seq>-<止seq>.{parquet,jsonl}
# 外部引擎直读（DuckDB 可从路径还原 conv/dt 分区键并下推裁剪）：
#   SELECT * FROM read_parquet('s3://<bucket>/chat-vectors/conv=*/dt=*/*.parquet', hive_partitioning=true);
# 若历史上用过 jsonl，务必把两种格式 UNION ALL，否则会漏掉切换之前写入的行：
#   SELECT * FROM read_json_auto('s3://<bucket>/chat-vectors/conv=*/dt=*/*.jsonl');
# COLD_EXPORT_ENABLED=true       # 置为 false 则只保留整库快照
# COLD_EXPORT_PREFIX=chat-vectors
# COLD_EXPORT_FORMAT=parquet     # 默认 parquet（列存+zstd，向量场景体积约为 jsonl 的 1/3）
#                                # 改成 jsonl 可换取可读性（jq 直接看），代价是体积约 3 倍
#                                # 两者可混存：改格式后老 part 无需回填，读侧按扩展名自动分派；
#                                # _schema.json 会列出数据集里全部格式及各自的读取表达式
#                                # 注意：用 `go build -tags noparquet` 编出的精简版（小 ~10MB）
#                                # 不含 parquet，此项设为 parquet 会启动报错，且无法读取已有的
#                                # .parquet part（会明确报错而非静默漏行）
# COLD_EXPORT_INTERVAL=1m        # 增量导出周期
# COLD_HOT_RETENTION=720h        # 已落冷层且超过该时长的消息，从热层剥离向量与思考过程（正文保留）；0=不裁剪
# COLD_CACHE_MB=64               # 冷层 part 的进程内缓存上限（part 不可变，缓存永不失效）

# 整库快照（灾备用，已不再是聊天数据的主链路）
# SNAPSHOT_INTERVAL=6h           # 0 或负值关闭
# SNAPSHOT_KEEP=8                # 保留最近多少代快照，更旧的自动清理

# AI 转型驾驶舱 (cockpit) 部署所需 —— Claude 网关配置（必填，否则 AI 内容无法生成）
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
