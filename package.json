{
  "name": "aimarketing",
  "private": true,
  "version": "1.9.6",
  "type": "module",
  "scripts": {
    "dev:tauri": "set RUST_LOG=debug,h2=warn,hyper=warn,reqwest=warn,tracing=warn,rustls=warn,tokio_util=warn,hyper_util=warn,tungstenite=warn,async_tungstenite=warn,serde_json=warn,serde=warn& node scripts/tauri-dev.mjs",
    "cua:build": "node scripts/build-cua-driver.mjs",
    "cua:build:force": "node scripts/build-cua-driver.mjs --force",
    "cua:check": "node scripts/build-cua-driver.mjs --check",
    "dev:cua": "node scripts/build-cua-driver.mjs && pnpm dev:tauri",
    "dev:tauri:trace": "set RUST_LOG=trace,h2=warn,hyper=warn,reqwest=warn,tracing=warn,rustls=warn,tokio_util=warn,hyper_util=warn,tungstenite=warn,async_tungstenite=warn,serde_json=warn,serde=warn& set CUA_DRIVER_TRACE=1& node scripts/tauri-dev.mjs",
    "dev:cua:trace": "node scripts/build-cua-driver.mjs && set RUST_BACKTRACE=1& pnpm dev:tauri:trace",
    "dev:cua:debug": "node scripts/build-cua-driver.mjs && set RUST_BACKTRACE=1& set RUST_LOG=debug,h2=warn,hyper=warn,reqwest=warn,tracing=warn,rustls=warn,tokio_util=warn,hyper_util=warn,tungstenite=warn,async_tungstenite=warn,serde_json=warn,serde=warn& set CUA_DRIVER_TRACE=1& node scripts/tauri-dev.mjs",
    "dev:tauri:skip-cua": "set CUA_SKIP_CHECK=1& pnpm dev:tauri",
    "dev:tauri:fast": "set RUST_LOG=debug,h2=warn,hyper=warn,reqwest=warn,tracing=warn,rustls=warn,tokio_util=warn,hyper_util=warn,tungstenite=warn,async_tungstenite=warn,serde_json=warn,serde=warn& node scripts/tauri-dev.mjs --profile release-fast",
    "dev:cua:fast": "node scripts/build-cua-driver.mjs && pnpm dev:tauri:fast",
    "build:tauri": "node scripts/tauri-dev.mjs build",
    "build:nsis": "powershell -ExecutionPolicy Bypass -File ./build.ps1 -Nsis",
    "build:nsis:ultra": "powershell -ExecutionPolicy Bypass -File ./build.ps1 -Nsis -UltraFast",
    "build:nsis:nofe": "powershell -ExecutionPolicy Bypass -File ./build.ps1 -Nsis -NoFrontend",
    "build:nsis:check": "powershell -ExecutionPolicy Bypass -File ./build.ps1 -Nsis -Check",
    "build:release-fast": "cargo build --manifest-path src-tauri/Cargo.toml --profile release-fast",
    "tauri": "tauri",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "check:fast": "cargo check --manifest-path src-tauri/Cargo.toml --lib",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "clean": "powershell -ExecutionPolicy Bypass -File ./build.ps1 -Soft -SkipBuild",
    "clean:target": "powershell -ExecutionPolicy Bypass -File ./build.ps1 -Clean -SkipBuild",
    "clean:all": "powershell -ExecutionPolicy Bypass -File ./build.ps1 -Clean -SkipBuild && node -e \"require('fs').rmSync('node_modules/.vite',{recursive:true,force:true}); console.log('[clean] .vite cache removed')\"",
    "build:nsis:full": "powershell -ExecutionPolicy Bypass -File ./build.ps1 -Nsis -Full",
    "build:nsis:ci": "powershell -ExecutionPolicy Bypass -File ./build.ps1 -Nsis -CI",
    "build:nsis:aggressive": "powershell -ExecutionPolicy Bypass -File ./build.ps1 -Nsis -Aggressive",
    "build:nsis:safeopc": "powershell -ExecutionPolicy Bypass -File ./build.ps1 -Nsis -Brand safeopc",
    "build:nsis:safeopc:full": "powershell -ExecutionPolicy Bypass -File ./build.ps1 -Nsis -Full -Brand safeopc",
    "build:mac:safeopc": "tauri build --config src-tauri/tauri.safeopc.conf.json --bundles app,dmg",
    "ci:check": "node scripts/ci-status-check.cjs",
    "ci:quick": "node scripts/ci-status-check.cjs --quick",
    "ci:skills": "node scripts/ci-status-check.cjs --skills"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  },
  "packageManager": "pnpm@9.10.0+sha512.73a29afa36a0d092ece5271de5177ecbf8318d454ecd701343131b8ebc0c1a91c487da46ab77c8e596d6acf1461e3594ced4becedf8921b074fbd8653ed7051c"
}
