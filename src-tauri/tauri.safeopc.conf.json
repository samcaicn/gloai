{
  "productName": "AIMarketing",
  "identifier": "com.aimarketing.desktop",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["aimarketing"]
      }
    }
  },
  "app": {
    "macOSPrivateApi": true
  },
  "bundle": {
    "publisher": "AIMarketing",
    "shortDescription": "AIMarketing - Industrial-Grade AI Desktop Workspace",
    "longDescription": "AIMarketing is the OEM edition of the AIMarketing workspace: a multi-agent Hermes backend, an extensible terminal, notebook, and a self-healing skill engine, packaged for AIMarketing production tenants.",
    "copyright": "Copyright (c) 2026 AIMarketing",
    "homepage": "https://aimarketing.example.com",
    "icon": [
      "icons-safeopc/32x32.png",
      "icons-safeopc/128x128.png",
      "icons-safeopc/128x128@2x.png",
      "icons-safeopc/icon.icns",
      "icons-safeopc/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons-safeopc/icon.ico",
        "startMenuFolder": "AIMarketing",
        "compression": "lzma",
        "installMode": "currentUser",
        "installerHooks": "installer/installer.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "height": 400, "width": 660 }
      },
      "entitlements": "entitlements.plist"
    }
  }
}
