# Wrangler 本地开发密钥示例（仅 wrangler dev 读取，不要提交到 git）
# 生产用：wrangler secret put <NAME>
#
# 默认服务商模式（WXPAY_SP_MODE=partner）。走直连商户时把下面 SP_/SUB_ 两组
# 换成 WXPAY_MCHID + WXPAY_APPID，并把 wrangler.toml 的 WXPAY_SP_MODE 改成 merchant。

# ---- 公共（两种模式都要） ----
# 商户 API 证书序列号（服务商模式下 = 服务商商户的 API 证书序列号）
WXPAY_SERIAL=0000000000000000000000000000000000000000
WXPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
WXPAY_V3KEY=01234567890123456789012345678901

# ---- 服务商模式（partner）----
WXPAY_SP_MCHID=1600000000
WXPAY_SP_APPID=wx0000000000000000
# 子商户（特约商户）商户号 —— 实际收款方
WXPAY_SUB_MCHID=1900000000
# 选填：子商户 AppID（须与 sub_mchid 有绑定关系）
WXPAY_SUB_APPID=

# ---- 直连商户模式（merchant）时才需要 ----
# WXPAY_MCHID=1600000000
# WXPAY_APPID=wx0000000000000000
